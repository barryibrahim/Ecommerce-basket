<!doctype html>
<html lang="fr">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>
			{% block title %}Ecommerce
			{% endblock %}
		</title>
		{% block stylesheets %}
			<link href="https://bootswatch.com/5/lumen/bootstrap.min.css" rel="stylesheet">
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
		{% endblock %}
	</head>
	<body>
		<nav class="navbar navbar-expand-lg bg-primary" data-bs-theme="dark">
			<div class="container-fluid">
				<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs- target="#navbarColor03" aria-controls="navbarColor03" aria-expanded="false" aria- label="Toggle navigation">
					<span class="navbar-toggler-icon"></span>
				</button>
				<div class="collapse navbar-collapse" id="navbarColor03">
					<ul class="navbar-nav me-auto">
						<li class="nav-item">
							<a class="nav-link active" href="{{path('app_accueil')}}">Accueil
								<span class="visually-hidden">(current)</span>
							</a>
						</li>
						<li class="nav-item">
							<a class="nav-link" href="{{path('app_produit')}}">Produit</a>
						</li>
						<a class="nav-link" href="{{path('app_contact')}}">Contact</a>
					</li>
				
					<li class="nav-item dropdown">
						<a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#" role="button" aria-haspopup="true" aria-expanded="false">Admin</a>
						<div class="dropdown-menu">
							
							<a class="nav-link" href="{{path('app_liste_produits')}}">Liste-Produits</a>
							<a class="nav-link" href="{{path('app_liste_contacts')}}">Liste-Contacts</a>
							<a class="dropdown-item" href="{{path('app_liste_utilisateurs')}}">Liste-Utilisateurs</a>
							<div class="dropdown-divider"></div>
							<a class="dropdown-item" href="#">Separated link</a>
						</div>
					</li>

				</ul>
				<form class="d-flex">
					<input class="form-control me-sm-2" type="search" placeholder="Search">
					<button class="btn btn-secondary my-2 my-sm-0" type="submit">Search</button>
				</form>
				<ul class="navbar-nav me-auto">
					{% if not
is_granted('IS_AUTHENTICATED_FULLY') %}
						<li class="nav-item">
							<a class="nav-link" href="{{path('app_login')}}">Se connecter
							</a>
						</li>
						<li class="nav-item">
							<a class="nav-link" href="{{path('app_register')}}">S'inscrire
							</a>
						</li>
					{% else %}
						{% if is_granted('ROLE_ADMIN') or is_granted('ROLE_MOD')%}
							<li class="nav-item">
								<a class="nav-link text-white" href="{{path('app_liste_contacts')}}">Liste des contacts</a>
							</li>


						{% endif %}
						{% if is_granted('IS_AUTHENTICATED_FULLY') %}
							<li class="nav-item">
								<a class="nav-link" href="{{ path('app_favoris') }}">
									<i class="bi bi-heart{{ app.user.produits|length > 0 ? '-fill text-danger' : '' }}"></i>
									{% if app.user.produits|length > 0 %}
										<span class="badge badge-danger">{{ app.user.produits|length }}</span>
									{% endif %}
								</a>
							</li>
						{% endif %}

						<li class="nav-item">
							<a class="nav-link" href="{{path('app_logout')}}">
								{{app.user.email}}
								<i class="bi
																																																															bi-x-circle-fill"></i>
							</a>
						</li>
					{% endif %}
					{% if app.user %}
						<li class="nav-item">
							<a class="nav-link" href="{{ path('app_profil') }}">Mon Profil</a>
						</li>
					{% endif %}
				</div>
			</div>
		</nav>
		{% for message in app.flashes('notice') %}
			<h2 class="alert alert-warning text-center mt-4 mb-4" role="alert">
				{{ message }}
			</h2>
		{% endfor %}
		{% block body %}Ecommerce
		{% endblock %}
		{% block javascripts %}
			<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
		{% endblock %}
	</body>
</html>
