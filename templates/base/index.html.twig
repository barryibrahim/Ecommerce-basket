{% extends 'base.html.twig' %}
{% block title %}
	{{parent()}}Accueil
{% endblock %}
{% block body %}
	<div class="contrainer-fluid">
		<h1 class="text-center text-primary mt-4 pt-4 display-1 fw-bold">
			<em>BALLONS DE BASKETBALL</sem>
		</h1>
		<h2 class="text-center text-primary">
			<em>Retrouvez une sélection des meilleurs ballons de basket</sem>
		</h2>
		<div class="row justify-content-center">
			{% for produit in produits %}
				<div class="col">
					<div
						class="card">
						<!-- Vérifie si le produit a une image -->
						{% if produit.image %}
							<img src="{{ asset('images/produit/' ~ produit.image) }}" class="card-img-top" alt="{{ produit.nom }}">
						{% else %}
							<img src="{{ asset('images/default.jpg') }}" class="card-img-top" alt="Image par défaut">
						{% endif %}

						<div class="card-body">
							<h5 class="card-title">{{ produit.nom }}</h5>
							<p class="card-text">{{ produit.prix }}€</p>
							<p class="card-text">{{ produit.description }}</p>
							<p class="card-text">Stock :
								{{ produit.stock }}</p>
							<a href="{{ path('app_aimer_produit', {'id': produit.id}) }}" class="heart-icon">
								{% if is_granted('IS_AUTHENTICATED_FULLY') %}
									{% if produit in app.user.produits %}
										<i class="bi bi-heart-fill text-danger"></i>
									{% else %}
										<i class="bi bi-heart"></i>
									{% endif %}
								{% endif %}
							</a>

						</div>
					</div>
				</div>
			{% endfor %}
		</div>

	{% endblock %}
