{% extends 'base.html.twig' %}

{% block title %}
	{{ produit.nom }}
	- Détail produit
{% endblock %}

{% block body %}
	<style>
		.custom-img {
			max-width: 200px; /* Ajustez cette valeur selon vos besoins */
			height: auto; /* Maintient le ratio d'aspect */
		}
		ul {
			list-style-type: none; /* Supprime les puces */
			padding: 0; /* Supprime le padding */
		}
		li {
			margin-bottom: 20px; /* Ajoute un espacement entre les éléments */
		}
	</style>
	<div class="container-fluid">
		<div class="row justify-content-center">
			<div class="col-10 text-primary">
				<h1 class="text-center text-primary mt-4 pt-4 display-1 fw-bold">{{ produit.nom }}</h1>
				


				{% if produit.image %}
					<img src="{{ asset('images/produit/' ~ produit.image) }}" class="card-img-top img-fluid custom-img" alt="{{ produit.nom }}">
				{% else %}
					<img src="{{ asset('images/default.jpg') }}" class="card-img-top img-fluid custom-img" alt="Image par défaut">
				{% endif %}

				<p style="font-size: 18px; color: #555;">
					<strong>Nom :</strong>
					{{ produit.nom }}
				</p>
				<p style="font-size: 18px; color: #555;">
					<strong>Description :</strong>
					{{ produit.description }}
				</p>
				<p style="font-size: 18px; color: #555;">
					<strong>Prix :</strong>
					{{ produit.prix }}
					€
				</p>
				<p style="font-size: 18px; color: #555;">
					<strong>Stock :</strong>
					{{ produit.stock }}
					€
				</p>
			</div>
		</div>
	</div>
{% endblock %}
